#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
secrets_dir="$repo_root/secrets/qbittorrent"
api_key_file="$secrets_dir/api_key"

mkdir -p "$secrets_dir"

generate_api_key() {
  if [ -e "$api_key_file" ]; then
    echo "Refusing to overwrite existing qBittorrent API key: $api_key_file" >&2
    return 1
  fi

  local api_key
  api_key="qbt_$(openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | cut -c1-28)"
  if [ "${#api_key}" -ne 32 ]; then
    echo "Failed to generate a valid qBittorrent API key." >&2
    return 1
  fi

  printf '%s' "$api_key" > "$api_key_file"
  chmod 0600 "$api_key_file"
  unset api_key
}

if [ "${1:-}" = "--api-key-only" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: qbittorrent-generate-password [--api-key-only]" >&2
    exit 2
  fi
  generate_api_key
  exit
elif [ "$#" -ne 0 ]; then
  echo "Usage: qbittorrent-generate-password [--api-key-only]" >&2
  exit 2
fi

read -r -s -p "qBittorrent password: " password
printf '\n' >&2
read -r -s -p "Confirm qBittorrent password: " password_confirm
printf '\n' >&2

if [ "$password" != "$password_confirm" ]; then
  echo "Passwords do not match." >&2
  exit 1
fi

printf '%s' "$password" > "$secrets_dir/password"
chmod 0600 "$secrets_dir/password"

qbittorrent_password -i "$secrets_dir/password" -f "$secrets_dir/password_pbkdf2"
chmod 0600 "$secrets_dir/password_pbkdf2"

if [ ! -e "$api_key_file" ]; then
  generate_api_key
fi
